# Variables de CircleLink : toutes lues à l'exécution, côté serveur (constitution VII.3).
#
# En production, tu n'as pas à écrire ce fichier :
# - Coolify génère les variables à partir de docker-compose.yml ;
# - ailleurs, ./scripts/init-env.sh <url> écrit un .env complet.
#
# En développement : copie ce fichier dans .env.development.local (non versionné).
# Les valeurs ci-dessous correspondent à compose.dev.yaml (pnpm db:up).

# URL publique de la page : balises de partage, emails, Better Auth.
SITE_URL=http://localhost:3000

# PostgreSQL : l'app utilise le rôle limité circlelink_app (créé au démarrage avec ce
# mot de passe) ; les migrations, le rôle propriétaire du schéma.
DATABASE_URL=postgres://circlelink_app:dev-app@localhost:54329/circlelink
DATABASE_MIGRATION_URL=postgres://circlelink_owner:dev-owner@localhost:54329/circlelink

# Better Auth : secret de 32 caractères au moins (openssl rand -hex 32).
BETTER_AUTH_SECRET=

# Facultatif : SMTP (Resend, Brevo…) pour le lien magique et le mot de passe oublié.
# Sans SMTP_HOST ni SMTP_FROM, la connexion se fait par mot de passe seulement.
# En dev, compose.dev.yaml fournit smtp4dev : SMTP_HOST=localhost, SMTP_PORT=2525.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# La newsletter (Brevo, Mailchimp, MailerLite, Kit) se branche dans l'espace → Newsletter :
# aucune variable à renseigner ici.

# Facultatif : déclenchement externe de la reprise de la file newsletter
# (POST /api/newsletter/retry). L'app la relance déjà seule toutes les 15 minutes.
NEWSLETTER_RETRY_SECRET=

# Dev uniquement : base de test de `pnpm test:pg` (compose.dev.yaml)
TEST_DATABASE_URL=postgres://circlelink_owner:dev-owner@localhost:54329/circlelink_test
